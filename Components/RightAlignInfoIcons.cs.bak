class RightAlignInfoIcons : ModSystem
{
    static readonly MethodInfo Main_GetInfoAccIconPosition_Method = typeof(Main).GetMethod("GetInfoAccIconPosition", BindingFlags.NonPublic | BindingFlags.Static);
    static readonly MethodInfo Main_DrawInfoAccs_Method = typeof(Main).GetMethod("DrawInfoAccs", BindingFlags.NonPublic | BindingFlags.Instance);

    public override void Load()
	{
		MonoModHooks.Modify(Main_GetInfoAccIconPosition_Method, IL_Main_GetInfoAccIconPosition);
		MonoModHooks.Modify(Main_DrawInfoAccs_Method, IL_Main_DrawInfoAccs);
	}

	static void IL_Main_GetInfoAccIconPosition(ILContext il)
	{
		ILCursor c = new(il);
		/*
			// X = screenWidth - 280;
			// sequence point: (line 40248, col 4) to (line 40248, col 26) in D:\a\tModLoader\tModLoader\src\tModLoader\Terraria\Main.cs
			IL_0007: ldarg.2
			IL_0008: ldsfld int32 Terraria.Main::screenWidth
			IL_000d: ldc.i4 280
			IL_0012: sub
			IL_0013: stind.i4
		*/
		c.GotoNext(
			i => i.MatchLdarg(2),
			i => i.MatchLdsfld(typeof(Main), nameof(Main.screenWidth)),
			i => i.MatchLdcI4(280),
			i => i.MatchSub(),
			i => i.MatchStindI4()
		);
		// Replace:
		//     X = screenWidth - 280;
		// With:
		//     X = screenWidth - 68;
		c.GotoNext(
			i => i.MatchLdcI4(280)
		);
		c.Remove();
		c.Emit(OpCodes.Ldc_I4, 68);
		/*
			// X = screenWidth - 280 + 20 * (drawnCount % 12) - 10;
			// sequence point: (line 40258, col 4) to (line 40258, col 56) in D:\a\tModLoader\tModLoader\src\tModLoader\Terraria\Main.cs
			IL_0043: ldarg.2
			IL_0044: ldsfld int32 Terraria.Main::screenWidth
			IL_0049: ldc.i4 280
			IL_004e: sub
			IL_004f: ldc.i4.s 20
			IL_0051: ldarg.0
			IL_0052: ldc.i4.s 12
			IL_0054: rem
			IL_0055: mul
			IL_0056: add
			IL_0057: ldc.i4.s 10
			IL_0059: sub
			IL_005a: stind.i4
		*/
		c.GotoNext(
			i => i.MatchLdarg(2),
			i => i.MatchLdsfld(typeof(Main), nameof(Main.screenWidth)),
			i => i.MatchLdcI4(280),
			i => i.MatchSub(),
			i => i.MatchLdcI4(20),
			i => i.MatchLdarg(0),
			i => i.MatchLdcI4(12),
			i => i.MatchRem(),
			i => i.MatchMul(),
			i => i.MatchAdd(),
			i => i.MatchLdcI4(10),
			i => i.MatchSub(),
			i => i.MatchStindI4()
		);
		// Replace:
		//     X = screenWidth - 280 + 20 * (drawnCount % 12) - 10;
		// With:
		//     X = screenWidth - 68 - 20 * (drawnCount % 12);
		c.GotoNext(
			i => i.MatchLdcI4(280)
		);
		c.Remove();
		c.Emit(OpCodes.Ldc_I4, 68);
		c.GotoNext(
			i => i.MatchAdd()
		);
		c.Remove();
		c.Emit(OpCodes.Sub);
		c.GotoNext(
			i => i.MatchLdcI4(10),
			i => i.MatchSub()
		);
		c.RemoveRange(2);
	}

