using Terraria;
using Terraria.ModLoader;

using DALib.Checks;

namespace DAMod.Components.Items;

public class NoAmmoDamageClass : GlobalItem
{
    public override bool AppliesToEntity(Item item, bool lateInstantiation) => item.IsNonUseableAmmo();
    public override void SetDefaults(Item item)
    {
        item.DamageType = DamageClass.Default;
    }
}

